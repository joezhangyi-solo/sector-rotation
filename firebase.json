{
  "hosting": [
    {
      "target": "sectorrotation",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/data.json",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=600" }
          ]
        }
      ]
    }
  ]
}
